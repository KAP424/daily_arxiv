# --- 打包产物 ---
# dist/ 是 build_exe.py 的输出 (283MB 的 exe 放这里)。
# exe 通过 GitHub Releases 发布, 不进仓库。
dist/
build/
*.spec

# PyInstaller 打包用的临时虚拟环境, build_exe.py --venv 会自动重建
.build_venv/
.venv/
venv/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/

# --- 运行期数据 (每台机器各不相同, 不进仓库) ---
cache/
output/
*.sqlite
*.sqlite-journal

# 本地配置: 含 API key 和个人 PDF 路径。模板见 config.example.json,
# 首次运行 ui.py 也会自动生成一份。
config.json

# --- 编辑器 / 系统 ---
.vscode/
.idea/
.DS_Store
Thumbs.db
